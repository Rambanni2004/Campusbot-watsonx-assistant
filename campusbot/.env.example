# Copy this file to .env and fill in your own values. NEVER commit .env.
WATSONX_ASSISTANT_APIKEY=your-ibm-cloud-api-key
WATSONX_ASSISTANT_URL=https://api.REGION.assistant.watson.cloud.ibm.com/instances/YOUR_INSTANCE_ID
WATSONX_ASSISTANT_ID=your-assistant-id
WATSONX_ENVIRONMENT_ID=your-live-environment-id

# Backend (optional)
API_KEY=choose-a-secret-key-for-the-leave-api
PORT=5000
